# Skip the zsh rc on machines without zsh installed — mirrors the old install.sh
# guard ("only create a missing rc file when its shell is actually installed").
# bash is assumed present in every target image, so .bashrc is always managed.
{{ if not (lookPath "zsh") }}.zshrc{{ end }}

# Repo-root files that are not source state — never apply them to $HOME.
README.md
install.sh
renovate.json


# Pinned github.com host keys serve only the berths' board clones
# (.chezmoiexternal.toml.tmpl); the Mac's own known_hosts already trusts GitHub.
{{ if eq .chezmoi.os "darwin" }}.config/board/github_known_hosts{{ end }}
