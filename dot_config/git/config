# ~/.config/git/config — managed by chezmoi (rinman24/dotfiles)
#
# Lives at the XDG path, which git reads as global config automatically, so
# ~/.gitconfig stays free for machine-local overrides: it is read AFTER this file,
# so a deliberate `git config --global …` still wins over anything set here.

[user]
	name = Rich Inman, PhD
	email = rinman24@gmail.com

[commit]
	gpgsign = false

# GenShift work commits use the work address. Keyed on the REMOTE URL rather than
# `includeIf "gitdir:…"`, so it holds wherever a repo is cloned. Requires
# git >= 2.36 for `hasconfig:`.
#
# One stanza per URL shape — no single pattern covers them all:
#   * GitHub SSH and HTTPS are different prefixes.
#   * Azure DevOps' clone button hands out the userinfo form
#     (https://genshift@dev.azure.com/…), which `https://dev.azure.com/**` misses.
#   * Azure DevOps SSH is git@ssh.dev.azure.com:v3/<org>/…
# Anything not matched falls through to the personal address above.
[includeIf "hasconfig:remote.*.url:https://github.com/genshift-energy/**"]
	path = ~/.config/git/genshift.inc
[includeIf "hasconfig:remote.*.url:git@github.com:genshift-energy/**"]
	path = ~/.config/git/genshift.inc
[includeIf "hasconfig:remote.*.url:https://dev.azure.com/genshift/**"]
	path = ~/.config/git/genshift.inc
[includeIf "hasconfig:remote.*.url:https://*@dev.azure.com/genshift/**"]
	path = ~/.config/git/genshift.inc
[includeIf "hasconfig:remote.*.url:git@ssh.dev.azure.com:v3/genshift/**"]
	path = ~/.config/git/genshift.inc
