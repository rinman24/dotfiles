{{- /*
   The board's two repos (github.com/rinman24/board, public; board-knowledge,
   private). Berths only: on the Mac they are hand-managed working copies and
   chezmoi must never pull under them. SSH URLs because git-repo externals need
   them for private repos; the agent is forwarded by billet's personal_bootstrap_cmd.
   Agents are generated from these by run_after_board-agents.sh.tmpl.

   Declared only when an ssh agent is reachable. Workspace repos also run
   `chezmoi update` from postCreateCommand, which billet runs over
   `docker compose exec` with no agent, so an SSH clone there can only fail and
   takes postCreate down with it. Skipped there, the clones happen in the
   agent-forwarded personal bootstrap that follows; once cloned, a later
   agentless apply leaves them alone.

   The berth's known_hosts carries no github.com entry, so git's ssh is pointed
   at the pinned keys in ~/.config/board/github_known_hosts, with strict
   checking. `git clone -c` sets core.sshCommand before the fetch and keeps it
   in the clone's config, so later pulls use it too.
*/ -}}
{{- $sock := env "SSH_AUTH_SOCK" }}
{{- if and (ne .chezmoi.os "darwin") $sock (stat $sock) }}
{{- $ssh := printf "core.sshCommand=ssh -o UserKnownHostsFile=%s -o StrictHostKeyChecking=yes" (joinPath .chezmoi.homeDir ".config/board/github_known_hosts") }}
["src/board"]
    type = "git-repo"
    url = "git@github.com:rinman24/board.git"
    refreshPeriod = "24h"
    [ "src/board".clone ]
        args = ["-c", {{ $ssh | quote }}]
    [ "src/board".pull ]
        args = ["--ff-only"]

["src/board-knowledge"]
    type = "git-repo"
    url = "git@github.com:rinman24/board-knowledge.git"
    refreshPeriod = "24h"
    [ "src/board-knowledge".clone ]
        args = ["-c", {{ $ssh | quote }}]
    [ "src/board-knowledge".pull ]
        args = ["--ff-only"]
{{- end }}
